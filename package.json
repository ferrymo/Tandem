{
  "name": "tandem",
  "private": true,
  "version": "1.0.0-alpha.1",
  "type": "module",
  "description": "Tandem · 面向多团队多项目，让人与 AI Agent 共同规划、执行和交付的开源协作平台",
  "scripts": {
    "dev:server": "pnpm --filter @ztp/server dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter @ztp/server start",
    "start:web": "pnpm --filter web start",
    "build:mcp": "pnpm --filter @ztp/mcp build"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "magic-string": "^0.30.19"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core"
    ]
  }
}
