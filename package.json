{
  "name": "tandem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node --env-file=.env scripts/web.mjs dev",
    "dev:worker": "node --env-file=.env scripts/worker.mjs dev",
    "build": "corepack pnpm --filter @tandem/web build && corepack pnpm --filter @tandem/worker build && corepack pnpm --filter @tandem/mcp build && node scripts/prepare-web.mjs",
    "start": "node --env-file=.env scripts/web.mjs start",
    "start:worker": "node --env-file=.env scripts/worker.mjs start",
    "start:mcp": "node apps/mcp/dist/index.js",
    "typecheck": "corepack pnpm -r typecheck && tsc --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "tsx --env-file=.env scripts/integration.ts && tsx --env-file=.env scripts/collaboration-integration.ts",
    "test:e2e": "playwright test",
    "test:collaboration": "tsx --env-file=.env scripts/collaboration-smoke.ts",
    "test:collaboration:browser": "tsx --env-file=.env scripts/collaboration-smoke.ts --browser",
    "test:zentao": "tsx --env-file=.env --env-file=.env.zentao.local scripts/zentao-smoke.ts",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "zentao:up": "docker compose -f compose.zentao.yaml up -d --wait",
    "zentao:stop": "docker compose -f compose.zentao.yaml stop",
    "db:bootstrap": "tsx --env-file=.env scripts/db-bootstrap.ts",
    "db:migrate": "tsx --env-file=.env scripts/db-migrate.ts",
    "db:check": "tsx --env-file=.env scripts/db-check.ts",
    "db:backup": "node scripts/db-backup.mjs",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "local:init": "node scripts/setup.mjs",
    "db:restore:check": "tsx --env-file=.env scripts/restore-check.ts",
    "test:containers": "node scripts/verify-containers.mjs",
    "local:doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "globals": "^16.0.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "zod": "4.6.7",
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
