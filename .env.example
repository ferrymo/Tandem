# pnpm local:init generates local passwords in .env. Never commit .env.
NODE_ENV=development
PORT=3000
POSTGRES_PORT=55432
POSTGRES_DB=tandem
POSTGRES_PASSWORD=
MIGRATION_PASSWORD=
APP_PASSWORD=
WORKER_PASSWORD=
DATABASE_ADMIN_URL=
DATABASE_MIGRATION_URL=
DATABASE_URL=
WORKER_DATABASE_URL=
WORKER_POLL_MS=1000
WORKER_LEASE_MS=30000
WORKER_SHUTDOWN_MS=10000
LOG_LEVEL=info
# local:init generates the encryption key. Preserve it for session credential decryption.
SESSION_ENCRYPTION_KEY=
TANDEM_PUBLIC_URL=http://127.0.0.1:3000
# Fixed collaboration instance for inherited identities; never a global service account.
# Leave TANDEM_IDENTITY_URL unset until the deployment administrator configures it.
# TANDEM_IDENTITY_URL=https://collaboration.example.com/
TANDEM_IDENTITY_ID=primary
TANDEM_IDENTITY_LABEL=协作系统
# Exact upstream account names, comma-separated. Empty means no workspace creators.
TANDEM_COMMANDER_ACCOUNTS=
# Explicit opt-in for a trusted local/internal HTTP instance.
TANDEM_IDENTITY_ALLOW_HTTP=false

# Chat-completion compatible endpoint (e.g. https://model.example.com/v1).
# Model credentials are forwarded to the Worker only.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_ALLOW_HTTP=false
MODEL_ALLOWED_ORIGINS=
# Shared absolute path is recommended when Web and Worker are launched separately.
TANDEM_ARTIFACT_ROOT=data/delivery
TANDEM_ATTACHMENT_ROOT=data/attachments
TANDEM_CONNECTOR_ALLOWED_ORIGINS=
TANDEM_CONNECTOR_DB_HOSTS=
TANDEM_CONNECTOR_ALLOW_HTTP=false
TANDEM_CONNECTOR_MYSQL_TLS=false
# Pull this pinned image once before running isolated tests/builds.
TANDEM_EXECUTION_IMAGE=node@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
# Comma-separated explicit MCP HTTP origins / container image digests.
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_IMAGES=

